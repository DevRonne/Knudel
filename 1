        Write-Verbose "partnerIp: $partnerIp" -Verbose

      $netshArgsdelete = @(
            'nps',
            'delete',
            'remoteservergroup',
            ('name=RadiusGroup')
        )

        $delete = & netsh $netshArgsdelete | Out-Null

        $netshArgsadd = @(
            'nps',
            'add',
            'remoteservergroup',
            ('name=RadiusGroup')
        )

        $add = & netsh $netshArgsadd
        if(($add -join ' ') -notmatch 'Ok') { throw ('RadiusGroup creation failed: ' + ($add -join ' '))}


