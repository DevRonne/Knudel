Script 'ConfigureXML'{

    GetScript = {
        $path = 'D:\Resources\NPS\NPS_Export.xml'
        return @{ Result = "NPS_Export.xml present: $(Test-Path -LiteralPath $path)" }
    }
	TestScript = {
        $guardKey   = $using:guardKeyPath
        $guardValue = 'NPSXmlConfigured'
        if ([string]::IsNullOrWhiteSpace($guardKey))
        {
            throw "Guard registry key path is empty (ConfigData.AllNodes.GMNRegistryPath missing) - cannot evaluate '$guardValue'."
        }

        # Only existence of the guard value matters - its data is historical and ignored
        $guard = Get-ItemProperty -LiteralPath $guardKey -Name $guardValue -ErrorAction SilentlyContinue -ErrorVariable guardError
        if ($null -ne $guard)
        {
            Write-Verbose -Message "Guard value '$guardValue' exists under '$guardKey' - SID replacement is skipped."
            return $true
        }

        # Only 'key missing' (ObjectNotFound) and 'value missing' (InvalidArgument) prove the guard is absent;
        # any other error (e.g. access denied) fails the resource instead of triggering the SetScript
        if ($guardError.Count -gt 0 -and $guardError[0].CategoryInfo.Category.ToString() -notin @('ObjectNotFound', 'InvalidArgument'))
        {
            throw "Cannot read guard value '$guardValue' under '$guardKey': $($guardError[0].Exception.Message)"
        }

        Write-Verbose -Message "Guard value '$guardValue' not found under '$guardKey' - checking whether the XML still contains the builtin Users SID."
        $path = 'D:\Resources\NPS\NPS_Export.xml'
        if (-not (Test-Path -LiteralPath $path)) { return $false }
        return [bool]((Get-Content -Path $path -Raw -ErrorAction Stop) -notmatch 'S-1-5-32-545')
    }
	SetScript = {
        $user = $using:AdminGroup
        Write-Verbose "User found in setscript: $($user)" -Verbose
        $path = 'D:\Resources\NPS\NPS_Export.xml'
        $sid = (New-Object System.Security.Principal.NTAccount("$($user)")).Translate([System.Security.Principal.SecurityIdentifier]).Value

        $roh = (Get-Content -Path $path -Raw -ErrorAction Stop) -replace 'S-1-5-32-545', $sid
        if ($roh -notmatch [regex]::Escape($sid)) { throw "XML contains neither the placeholder nor the expected SID $sid - template from a foreign domain?" }

        $item = Get-Item $path
        if ($item.IsReadOnly) { $item.IsReadOnly = $false }
        [System.IO.File]::WriteAllText($path, $roh)

        # Stamp the guard value so the next TestScript pass skips the SID replacement
        if (-not (Test-Path -LiteralPath $using:guardKeyPath))
        {
            New-Item -Path $using:guardKeyPath -Force | Out-Null
        }
        $date = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
        Set-ItemProperty -LiteralPath $using:guardKeyPath -Name 'NPSXmlConfigured' -Value $date -Force -ErrorAction Stop
    }
    DependsOn = $Depends
}
    $Depends += "[Script]ConfigureXML"


Script 'ConfigNPS'{
	GetScript = {
        if (-not (Test-Path -Path $using:guardKeyPath))
        {
            return @{ Result = 'RegistryKeyAbsent' }
        }

        $copiedOnProperty = Get-ItemProperty -Path $using:guardKeyPath -Name 'NPSConfigImported' -ErrorAction SilentlyContinue
        if ($null -eq $copiedOnProperty)
        {
            return @{ Result = 'RegistryKeyPresent - NPSConfigImported value missing' }
        }

        @{ Result = "RegistryKeyPresent - NPSConfigImported '$($copiedOnProperty.NPSConfigImported)'" }
    }
    TestScript = {
        $guardKey   = $using:guardKeyPath
        $guardValue = 'NPSConfigImported'
        if ([string]::IsNullOrWhiteSpace($guardKey))
        {
            throw "Guard registry key path is empty (ConfigData.AllNodes.GMNRegistryPath missing) - cannot evaluate '$guardValue'."
        }

        # Only existence of the guard value matters - its data is historical and ignored
        $guard = Get-ItemProperty -LiteralPath $guardKey -Name $guardValue -ErrorAction SilentlyContinue -ErrorVariable guardError
        if ($null -ne $guard)
        {
            Write-Verbose -Message "Guard value '$guardValue' exists under '$guardKey' - NPS configuration import is skipped."
            return $true
        }

        # Only 'key missing' (ObjectNotFound) and 'value missing' (InvalidArgument) prove the guard is absent;
        # any other error (e.g. access denied) fails the resource instead of triggering the SetScript
        if ($guardError.Count -gt 0 -and $guardError[0].CategoryInfo.Category.ToString() -notin @('ObjectNotFound', 'InvalidArgument'))
        {
            throw "Cannot read guard value '$guardValue' under '$guardKey': $($guardError[0].Exception.Message)"
        }

        Write-Verbose -Message "Guard value '$guardValue' not found under '$guardKey' - NPS configuration import is required."
        return $false
    }
	SetScript = {
        $path = 'D:\Resources\NPS\NPS_Export.xml'
        $regPath = $using:guardKeyPath
        if (-not (Test-Path $path)) { throw 'NPS_Export.xml missing - import aborted.' }
        if((Get-Content -Path $path -Raw) -match 'S-1-5-32-545') { throw 'SID not changed - import aborted' }

        Write-Verbose "Import XML" -Verbose
		# Import runs only once
		Import-NpsConfiguration -Path $path -ErrorAction Stop

        Write-Verbose "Import successful" -Verbose

		Write-Verbose 'NPS-configuration imported, RegKey NPSConfigImported=Executed set.' -Verbose
        if(-not (Test-Path -LiteralPath $regPath)) {
            New-Item $regPath -Force | Out-Null
        }
        $date = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
        Set-ItemProperty -LiteralPath $regPath -Name 'NPSConfigImported' -Value $date -Force -ErrorAction Stop
        # Import-NpsConfiguration replaced remote group, clients and filelog -> those resources must run again
        Remove-ItemProperty -LiteralPath $regPath -Name 'NPSRadiusGroupConfigured','NPSClientsImported','NPSAccountLogConfigured' -Force -ErrorAction SilentlyContinue

	}
    DependsOn = $Depends
 }
