Script Copy_NPS_Export {
    GetScript = {
        if (-not (Test-Path -Path $using:guardKeyPath))
        {
            return @{ Result = 'RegistryKeyAbsent - copy pending' }
        }

        $copiedOnProperty = Get-ItemProperty -Path $using:guardKeyPath -Name 'Copy_NPS_Export' -ErrorAction SilentlyContinue
        if ($null -eq $copiedOnProperty)
        {
            return @{ Result = 'RegistryKeyPresent - Copy_NPS_Export value missing, copy pending' }
        }

        @{ Result = "RegistryKeyPresent - Copy_NPS_Export '$($copiedOnProperty.Copy_NPS_Export)'" }
    }
    TestScript = {
        $guardKey   = $using:guardKeyPath
        $guardValue = 'Copy_NPS_Export'
        if ([string]::IsNullOrWhiteSpace($guardKey))
        {
            throw "Guard registry key path is empty (ConfigData.AllNodes.GMNRegistryPath missing) - cannot evaluate '$guardValue'."
        }

        # Only existence of the guard value matters - its data is historical and ignored
        $guard = Get-ItemProperty -LiteralPath $guardKey -Name $guardValue -ErrorAction SilentlyContinue -ErrorVariable guardError
        if ($null -ne $guard)
        {
            Write-Verbose -Message "Guard value '$guardValue' exists under '$guardKey' - copy to '$using:destinationPath' is skipped."
            return $true
        }

        # Only 'key missing' (ObjectNotFound) and 'value missing' (InvalidArgument) prove the guard is absent;
        # any other error (e.g. access denied) fails the resource instead of triggering the SetScript
        if ($guardError.Count -gt 0 -and $guardError[0].CategoryInfo.Category.ToString() -notin @('ObjectNotFound', 'InvalidArgument'))
        {
            throw "Cannot read guard value '$guardValue' under '$guardKey': $($guardError[0].Exception.Message)"
        }

        Write-Verbose -Message "Guard value '$guardValue' not found under '$guardKey' - copy to '$using:destinationPath' is required."
        return $false
    }
    SetScript = {
        $destinationFolder = Split-Path -Path $using:destinationPath -Parent
        Write-Debug -Message "Ensuring destination folder '$destinationFolder' exists."
        if (-not (Test-Path -Path $destinationFolder))
        {
            New-Item -Path $destinationFolder -ItemType Directory -Force | Out-Null
        }

        Write-Verbose -Message "Copying '$using:sourcePath' to '$using:destinationPath'."
        Copy-Item -Path $using:sourcePath -Destination $using:destinationPath -Force -ErrorAction Stop
        Write-Verbose -Message 'File copy completed.'

        # Stamp the guard value so the next TestScript pass reports the copy as done.
        # New-Item -Force on an existing key wipes every other guard value, so create the key only when it is missing
        if (-not (Test-Path -LiteralPath $using:guardKeyPath))
        {
            Write-Verbose -Message "Creating guard registry key '$using:guardKeyPath'."
            New-Item -Path $using:guardKeyPath -Force | Out-Null
        }
        $copiedOn = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
        Set-ItemProperty -LiteralPath $using:guardKeyPath -Name 'Copy_NPS_Export' -Value $copiedOn -Force -ErrorAction Stop
        Write-Verbose -Message 'File copy completed and guard registry key created.'

    }
    DependsOn = $Depends
}
$Depends += "[Script]Copy_NPS_Export"


