Script ImportClients{
    GetScript = {
        if (-not (Test-Path -Path $using:guardKeyPath))
        {
            return @{ Result = 'RegistryKeyAbsent' }
        }

        $copiedOnProperty = Get-ItemProperty -Path $using:guardKeyPath -Name 'NPSClientsImported' -ErrorAction SilentlyContinue
        if ($null -eq $copiedOnProperty)
        {
            return @{ Result = 'RegistryKeyPresent - NPSClientsImported value missing.' }
        }

        @{ Result = "RegistryKeyPresent - NPSClientsImported '$($copiedOnProperty.NPSClientsImported)'" }
    }
    TestScript = {
        $guardKey   = $using:guardKeyPath
        $guardValue = 'NPSClientsImported'
        if ([string]::IsNullOrWhiteSpace($guardKey))
        {
            throw "Guard registry key path is empty (ConfigData.AllNodes.GMNRegistryPath missing) - cannot evaluate '$guardValue'."
        }

        # Only existence of the guard value matters - its data is historical and ignored
        $guard = Get-ItemProperty -LiteralPath $guardKey -Name $guardValue -ErrorAction SilentlyContinue -ErrorVariable guardError
        if ($null -ne $guard)
        {
            Write-Verbose -Message "Guard value '$guardValue' exists under '$guardKey' - RADIUS client import is skipped."
            return $true
        }

        # Only 'key missing' (ObjectNotFound) and 'value missing' (InvalidArgument) prove the guard is absent;
        # any other error (e.g. access denied) fails the resource instead of triggering the SetScript
        if ($guardError.Count -gt 0 -and $guardError[0].CategoryInfo.Category.ToString() -notin @('ObjectNotFound', 'InvalidArgument'))
        {
            throw "Cannot read guard value '$guardValue' under '$guardKey': $($guardError[0].Exception.Message)"
        }

        Write-Verbose -Message "Guard value '$guardValue' not found under '$guardKey' - RADIUS client import is required."
        return $false
    }
    SetScript = {
        $pathtoCSV = "D:\Resources\NPS\data.csv"
        $regPath = $using:guardKeyPath
        $csvImport = Import-Csv -Path $pathtoCSV -Delimiter ';' -ErrorAction Stop
        $actualClients = Get-NpsRadiusClient |Select-Object -ExpandProperty 'Name'
        $csvRows = $csvImport
        $current = @($actualClients | Where-Object { $_ }) # what exists now (no phantom $null entry)
        $desired = @($csvRows | Where-Object { $_ })       # what the CSV says should exist
        if ($desired.Count -eq 0) { throw 'data.csv has no rows - sync aborted (would remove every client)' }
        $comparison = Compare-Object -ReferenceObject $current -DifferenceObject @($desired.Name)
        # Names that exist now but aren't in the CSV -> remove (a name is all you need here)
        $namesToRemove = @($comparison | Where-Object SideIndicator -eq '<=' | Select-Object -ExpandProperty InputObject)

        # Names in the CSV that don't exist yet -> add, rehydrated to the full row so you have the IP
        $namesToAdd = @($comparison | Where-Object SideIndicator -eq '=>' | Select-Object -ExpandProperty InputObject)
        $rowsToAdd = @($desired | Where-Object { $_.Name -in $namesToAdd })


        foreach ( $item in $namesToRemove ){
            Remove-NpsRadiusClient -Name $item -Verbose -ErrorAction Stop
        }

        foreach ( $item in $rowsToAdd ){
            Write-Verbose "ClientName: $($item.Name)" -Verbose
            Write-Verbose "Input: $($item.IP)" -Verbose
            New-NpsRadiusClient -Name $item.Name -Address $item.IP -SharedSecret $using:ConfigData.AllNodes.NPSSharedSecret -Verbose -ErrorAction Stop
        }
        #RegKey stores the hash of the ynced CSV - a changed CSV triggers a re-sync
        if (-not (Test-Path -LiteralPath $regPath)) {
            New-Item $regPath -Force | Out-Null
        }
        $date = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
        Set-ItemProperty -LiteralPath $regPath -Name 'NPSClientsImported' -Value $date -Force -ErrorAction Stop
        Write-Verbose "NPS clients synced, hsh stored in RegKey NPSClientsImported." -Verbose

    }

    DependsOn = $Depends
}
$Depends += "[Script]ImportClients"

